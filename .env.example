# Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Gymfolio frontend URL (used for CORS + Stripe success/cancel URLs in gymfolio payments)
GYMFOLIO_URL=http://localhost:3000

# Any other browser origin that must reach this API, comma separated. The
# member app's Expo web build is served from http://localhost:8081; the app on
# a phone sends no Origin header, so it needs no entry here.
EXTRA_CORS_ORIGINS=

# Optional. This API's own public address, e.g. https://api.yourgym.com. The
# link in a "confirm your email" message points back at the API; left unset
# it is built from the address the request came in on. Set it to pin that
# when something in front of the API passes any Host header through.
API_PUBLIC_URL=

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth (optional). The sign-in page only offers Google when all three
# are set. The redirect URI is this API's own callback, registered in the
# Google console: https://api.yourgym.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=

# Uploads. With a Vercel Blob token set, files go to Blob storage (required on
# Vercel, which has no writable disk); without it they land in ./uploads.
# The token also lets the admin pages send files too big for the API straight
# to the store (POST /api/uploads/blob; GET /api/uploads/capabilities says
# whether this server can).
BLOB_READ_WRITE_TOKEN=
# Size ceilings for image and video uploads through the API, in megabytes. On
# Vercel every upload through the API is capped at 4 MB whatever these say;
# larger files go straight to Blob instead (images up to 20 MB, videos up to
# UPLOAD_MAX_VIDEO_SIZE_MB).
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_VIDEO_SIZE_MB=100

# Set by Vercel itself (VERCEL=1); it is what turns on the 4 MB upload cap
# above. Leave it empty locally.
VERCEL=

# Stripe keys for the gym a single-gym deployment defaults to
# (DEFAULT_TENANT_SLUG). Every other gym enters its own keys under
# Settings → Stripe; these are never used for them.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Outbound email when the gym has not configured SMTP under Settings → Email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Sender line for the env-configured transport, e.g. "Your Gym <no-reply@yourgym.com>".
EMAIL_FROM=
# Fallback name for email subjects and senders when the gym in context has no
# siteName in its settings yet. Normally left unset.
SITE_NAME=

# Push notifications to the member app go through Expo. Only needed when
# "enhanced push security" is on in the Expo project: then only a server
# holding the project's access token may send.
EXPO_ACCESS_TOKEN=

# Secrets in a gym's Settings document (Stripe keys, SMTP password, messaging
# tokens) are sealed at rest with a key derived from this value. Falls back
# to JWT_SECRET when unset; set its own value so rotating the JWT secret does
# not make every stored credential unreadable. On a server that already holds
# secrets, set it to the CURRENT JWT_SECRET value (a fresh one would make the
# existing ones read as empty), and never change it afterwards.
SETTINGS_ENCRYPTION_KEY=

# Currency the accounts screens report in when a gym has not set one.
ACCOUNTS_CURRENCY=
# ---------------------------------------------------------------------------
# Front-desk attendance app (GymPilot_desktopApp)
# ---------------------------------------------------------------------------

# The gym's local timezone. Every attendance row is filed against the LOCAL
# date here, not the server's -- this backend runs in UTC on Vercel, so
# without this a 2am check-out lands on the wrong day and "today's attendance"
# is wrong for five hours every day.
ATTENDANCE_TIMEZONE=Asia/Karachi

# Encrypts fingerprint templates at rest (AES-256-GCM). Falls back to
# JWT_SECRET when unset, which works but ties biometric data to a key you may
# want to rotate for unrelated reasons -- rotating it makes every stored
# template unreadable. Set this to its own value in production; where
# templates are already enrolled, that value must be the CURRENT JWT_SECRET.
FINGERPRINT_ENCRYPTION_KEY=

# Seconds within which a repeat scan of the same person is reported as a
# no-op rather than acted on. Without it, a finger left resting on the reader
# checks someone straight back out again.
ATTENDANCE_MIN_PUNCH_GAP_SECONDS=60

# How far back a check-out may reach to find its own check-in. Longer than a
# working day so a night shift still closes correctly, short enough that
# someone who forgot to check out on Monday is not closed by Tuesday's
# arrival. Past it, a visit no longer counts as "still inside" anywhere, and
# the daily job marks it as having no check-out.
ATTENDANCE_OPEN_VISIT_HOURS=18

# Staff visits close sooner, so a forgotten check-out is not paid as one long
# shift when they come back the next morning: open until the rostered shift
# ends plus this many hours...
ATTENDANCE_STAFF_SHIFT_GRACE_HOURS=4
# ...or, with no roster for that day, this many hours after check-in (never
# longer than ATTENDANCE_OPEN_VISIT_HOURS).
ATTENDANCE_STAFF_OPEN_HOURS=14

# Minutes past a trainer's rostered start before an arrival counts as late.
ATTENDANCE_LATE_GRACE_MINUTES=5

# Days before a membership runs out that the desk starts being warned (amber
# rather than red), so it can be renewed while the member is at the counter.
ATTENDANCE_EXPIRY_WARNING_DAYS=7

# 1:N false-accept target for local fingerprint matching. The desktop app
# divides this by the number of enrolled templates, so it tightens
# automatically as the gym grows.
FINGERPRINT_FAR=100000

# ---------------------------------------------------------------------------
# Scheduled jobs (membership expiry, renewal reminders, class reminders)
# ---------------------------------------------------------------------------

# Shared secret for POST /api/jobs/reminders. The scheduler is outside this
# app -- serverless has no long-lived process to hold one -- so the daily job
# is an HTTP endpoint a cron pokes, and this is what proves the caller is that
# cron and not the internet.
#
# Leave it UNSET to disable scheduled jobs entirely: the route refuses
# everything without it, so forgetting to configure it cannot leave an open
# endpoint that emails the whole membership on demand.
#
#   curl -X POST https://api.yourgym.com/api/jobs/reminders \
#        -H "Authorization: Bearer $CRON_SECRET"
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# How many days before a membership ends to email the member, comma separated.
# Three points rather than one: a fortnight out is a nudge, a week out is a
# reminder, the day before is the last call. Each is sent at most once per
# membership.
MEMBERSHIP_REMINDER_DAYS=14,7,1

# How the daily job paces itself across gyms (src/platform/jobs.js).
# CONCURRENCY: gyms worked on side by side (1-10). BUDGET_MS: how long after
# the cron fired new gyms are still started; gyms already running finish, so
# keep it below the function's time limit by about one gym's run -- 45000
# suits a 60-second function, 240000 a 300-second one. Gyms not reached are
# listed under `schedule.deferred` and go first on the next run.
DAILY_JOB_CONCURRENCY=3
DAILY_JOB_BUDGET_MS=45000

# A member import (Users -> Import CSV) is one request, and a big file does
# not fit in one: after this many milliseconds it stops starting new rows,
# answers cleanly with how many are left, and the same file uploaded again
# carries on. Must be below the function's time limit by a few seconds --
# the default, 40000, suits a 60-second function.
IMPORT_BUDGET_MS=40000

# ---------------------------------------------------------------------------
# Multi-tenancy: one database per gym, one domain (or more) per gym
#
# Every request is matched to a gym by the website it came from (Origin /
# X-Tenant-Host / Host), then served from that gym's own database. Gyms are
# managed from the platform panel (GymPilot_marketing, /super-admin), or with the
# scripts under scripts/platform/. See MULTI_TENANCY.md.
# ---------------------------------------------------------------------------

# Where the platform's own records (gyms, plans, super admins) live. Defaults
# to the database named in MONGO_URI -- the main database, which also holds
# the first gym's data. Normally left unset.
PLATFORM_DB_NAME=

# New gyms get a database named <prefix><slug> on the MONGO_URI cluster.
# Defaults to "<main database>_", so with MONGO_URI ending in /GymPilot the
# gyms are GymPilot_gym1, GymPilot_gym2, … Normally left unset.
TENANT_DB_PREFIX=

# The gym to serve when a request carries no recognisable domain -- plain
# `localhost` in development, curl, the cron. Set this to the slug of the gym
# you registered with scripts/platform/registerExistingGym.js. Leave unset on
# a multi-gym deployment where every gym has its own domain.
DEFAULT_TENANT_SLUG=

# The gym whose Settings secrets and fingerprint templates were encrypted
# before keys were scoped per gym (the pre-platform gym). It keeps the
# original key for good. Falls back to DEFAULT_TENANT_SLUG when unset -- so
# set it to that same slug BEFORE unsetting DEFAULT_TENANT_SLUG, or that
# gym's stored Stripe/SMTP/messaging secrets read back empty and its
# fingerprints stop matching. A fresh multi-gym install leaves it unset.
LEGACY_KEY_TENANT_SLUG=

# Optional: <slug>.<this domain> resolves to the gym with that slug without
# registering a domain, e.g. ironworks.gympilot.app. Required for self-serve
# sign-up (below): a gym made that way has no other web address.
PLATFORM_ROOT_DOMAIN=

# Self-serve sign-up: the marketing site's checkout takes payment on the
# platform's Stripe account and the webhook builds the gym (BILLING.md). On
# whenever it can work -- PLATFORM_ROOT_DOMAIN set, and the platform's Stripe
# key, "charging on" and webhook signing secret saved under System -> Stripe.
# Set to "off" to send every new gym through the panel regardless.
PLATFORM_SELF_SERVE_SIGNUP=

# Super admin sessions. Falls back to JWT_SECRET (suffixed) when unset, but a
# separate secret means a gym-side leak cannot mint platform tokens.
PLATFORM_JWT_SECRET=
PLATFORM_TOKEN_TTL=12h

# First super admin, created on the first sign-in attempt when no super admin
# exists yet -- for hosts with no shell to run scripts/platform/createSuperAdmin.js.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: connect the website's Vercel project so a domain added to a gym
# in the platform panel is put on the project automatically (and removed
# when taken off). Without these the panel just shows the DNS record to add.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Where the marketing site and platform panel (GymPilot_marketing) are
# served from, comma separated for more than one (added to CORS). Links in
# emails use the first; a self-serve buyer is sent back from Stripe to the one
# they came from. Gym domains are allowed automatically once registered.
#
# REQUIRED IN PRODUCTION. Only a developer's machine gets a localhost
# stand-in; in production, without it, a super admin's "forgot password" is
# refused (no reset email can carry a link), self-serve sign-up stays off,
# and emails to the platform admins carry no link to the panel.
PLATFORM_ADMIN_ORIGIN=

# How the platform names itself in emails to gym owners, and the address
# those emails invite replies to.
PLATFORM_NAME=GymsPilotPro
PLATFORM_CONTACT_EMAIL=

# Set to 1 to let a gym be provisioned on its own MongoDB connection string
# (its own cluster, region or bill) instead of a database on MONGO_URI.
ALLOW_DEDICATED_DB_URI=

# Days a gym keeps being served after its subscription period ends, before it
# is marked expired and cut off. The daily cron applies this.
SUBSCRIPTION_GRACE_DAYS=7

# Signs the QR codes members show at the door (see KIOSK.md). Falls back to
# JWT_SECRET; set its own value so rotating one does not invalidate the other.
QR_TOKEN_SECRET=

# How long the set-password link in a new owner's welcome email stays valid (hours).
OWNER_INVITE_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Not read by the server
# ---------------------------------------------------------------------------

# Seeder/createAdmin.js: the admin account it creates, when --email /
# --password are not given on the command line.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seeder/createAttendance.js only: the one password its sample accounts get,
# when --password is not given (at least 8 characters). Left empty, the
# seeder makes one up and prints it once.
SEED_PASSWORD=

# `npm run test:integration` skips every test when its in-memory MongoDB
# cannot start; set to 1 (in CI) to fail instead. The tests never read .env,
# so export it in the shell or the CI job.
GYMPILOT_INTEGRATION_REQUIRED=

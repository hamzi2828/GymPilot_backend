# Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Gymfolio frontend URL (used for CORS + Stripe success/cancel URLs in gymfolio payments)
GYMFOLIO_URL=http://localhost:3000

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secret (generate a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# ---------------------------------------------------------------------------
# Front-desk attendance app (GymPilot_desktopApp)
# ---------------------------------------------------------------------------

# The gym's local timezone. Every attendance row is filed against the LOCAL
# date here, not the server's -- this backend runs in UTC on Vercel, so
# without this a 2am check-out lands on the wrong day and "today's attendance"
# is wrong for five hours every day.
ATTENDANCE_TIMEZONE=Asia/Karachi

# Encrypts fingerprint templates at rest (AES-256-GCM). Falls back to
# JWT_SECRET when unset, which works but ties biometric data to a key you may
# want to rotate for unrelated reasons -- rotating it makes every stored
# template unreadable. Set this to its own value in production.
FINGERPRINT_ENCRYPTION_KEY=

# Seconds within which a repeat scan of the same person is reported as a
# no-op rather than acted on. Without it, a finger left resting on the reader
# checks someone straight back out again.
ATTENDANCE_MIN_PUNCH_GAP_SECONDS=60

# How far back a check-out may reach to find its own check-in. Longer than a
# working day so a night shift still closes correctly, short enough that
# someone who forgot to check out on Monday is not closed by Tuesday's
# arrival.
ATTENDANCE_OPEN_VISIT_HOURS=18

# Minutes past a trainer's rostered start before an arrival counts as late.
ATTENDANCE_LATE_GRACE_MINUTES=5

# Days before a membership runs out that the desk starts being warned (amber
# rather than red), so it can be renewed while the member is at the counter.
ATTENDANCE_EXPIRY_WARNING_DAYS=7

# 1:N false-accept target for local fingerprint matching. The desktop app
# divides this by the number of enrolled templates, so it tightens
# automatically as the gym grows.
FINGERPRINT_FAR=100000

# ---------------------------------------------------------------------------
# Scheduled jobs (membership expiry, renewal reminders, class reminders)
# ---------------------------------------------------------------------------

# Shared secret for POST /api/jobs/reminders. The scheduler is outside this
# app -- serverless has no long-lived process to hold one -- so the daily job
# is an HTTP endpoint a cron pokes, and this is what proves the caller is that
# cron and not the internet.
#
# Leave it UNSET to disable scheduled jobs entirely: the route refuses
# everything without it, so forgetting to configure it cannot leave an open
# endpoint that emails the whole membership on demand.
#
#   curl -X POST https://api.yourgym.com/api/jobs/reminders \
#        -H "Authorization: Bearer $CRON_SECRET"
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# How many days before a membership ends to email the member, comma separated.
# Three points rather than one: a fortnight out is a nudge, a week out is a
# reminder, the day before is the last call. Each is sent at most once per
# membership.
MEMBERSHIP_REMINDER_DAYS=14,7,1

# ---------------------------------------------------------------------------
# Multi-tenancy: one database per gym, one domain (or more) per gym
#
# Every request is matched to a gym by the website it came from (Origin /
# X-Tenant-Host / Host), then served from that gym's own database. Gyms are
# managed from the platform panel (GymPilot_frontendAdmin, /super-admin), or with the
# scripts under scripts/platform/. See MULTI_TENANCY.md.
# ---------------------------------------------------------------------------

# Where the platform's own records (gyms, plans, super admins) live. Defaults
# to the database named in MONGO_URI -- the main database, which also holds
# the first gym's data. Normally left unset.
PLATFORM_DB_NAME=

# New gyms get a database named <prefix><slug> on the MONGO_URI cluster.
# Defaults to "<main database>_", so with MONGO_URI ending in /gymwear the
# gyms are gymwear_gym1, gymwear_gym2, … Normally left unset.
TENANT_DB_PREFIX=

# The gym to serve when a request carries no recognisable domain -- plain
# `localhost` in development, curl, the cron. Set this to the slug of the gym
# you registered with scripts/platform/registerExistingGym.js. Leave unset on
# a multi-gym deployment where every gym has its own domain.
DEFAULT_TENANT_SLUG=

# Optional: <slug>.<this domain> resolves to the gym with that slug without
# registering a domain, e.g. ironworks.gympilot.app.
PLATFORM_ROOT_DOMAIN=

# Super admin sessions. Falls back to JWT_SECRET (suffixed) when unset, but a
# separate secret means a gym-side leak cannot mint platform tokens.
PLATFORM_JWT_SECRET=
PLATFORM_TOKEN_TTL=12h

# First super admin, created on the first sign-in attempt when no super admin
# exists yet -- for hosts with no shell to run scripts/platform/createSuperAdmin.js.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: connect the website's Vercel project so a domain added to a gym
# in the platform panel is put on the project automatically (and removed
# when taken off). Without these the panel just shows the DNS record to add.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Where the platform panel is served from, if not one of the gym domains
# (added to CORS). Gym domains are allowed automatically once registered.
PLATFORM_ADMIN_ORIGIN=

# Days a gym keeps being served after its subscription period ends, before it
# is marked expired and cut off. The daily cron applies this.
SUBSCRIPTION_GRACE_DAYS=7

# Signs the QR codes members show at the door (see KIOSK.md). Falls back to
# JWT_SECRET; set its own value so rotating one does not invalidate the other.
QR_TOKEN_SECRET=
